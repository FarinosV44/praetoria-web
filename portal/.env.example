# Copia este archivo a .env.local SOLO en tu equipo o en el panel de variables del servidor.
# Nunca subas valores reales al repositorio. Todas las variables son de servidor salvo que empiecen por NEXT_PUBLIC_ (no hay ninguna).

# URL pública del portal (origen exacto, sin barra final)
PORTAL_ORIGIN=http://localhost:3100

# Base de datos (Postgres de Supabase en staging/producción). Tres roles distintos:
#  - portal_app: rol de la aplicación, SIN bypass de RLS.
#  - portal_auth: rol que gestiona las tablas de identidad (esquema identidad).
#  - administración: solo para migraciones y scripts, nunca en la aplicación.
DATABASE_URL_APP=postgresql://portal_app:CAMBIAR@127.0.0.1:54322/portal_dev
DATABASE_URL_AUTH=postgresql://portal_auth:CAMBIAR@127.0.0.1:54322/portal_dev
DATABASE_URL_ADMIN=postgresql://postgres@127.0.0.1:54322/portal_dev

# Sesiones (cadena aleatoria de 32+ bytes: openssl rand -base64 48)
BETTER_AUTH_SECRET=CAMBIAR

# Supabase Storage (API de Storage). La clave de servicio solo vive en el servidor.
STORAGE_URL=http://127.0.0.1:5050
STORAGE_SERVICE_KEY=CAMBIAR
STORAGE_BUCKET=portal-documentos

# Correo saliente (SMTP). En local, el capturador de scripts/smtp-dev.ts.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Praetoria Abogados <no-responder@praetoriaabogados.es>"

# Cabecera con la IP real del cliente que fija el proxy de confianza (obligatoria).
# En Hostinger, la comprobada en docs/portal/DESPLIEGUE-HOSTINGER.md.
TRUSTED_IP_HEADER=x-forwarded-for

# Clave de la tarea cron que dispara el motor de avisos (32+ caracteres: openssl rand -hex 32).
# Sin ella, la ruta /api/interno/avisos/ responde 404.
CRON_CLAVE=CAMBIAR

# Web Push (npx web-push generate-vapid-keys) y buzón de los avisos internos
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:juanjo@farvertrans.com
AVISOS_DESPACHO_EMAIL=

# Formularios de la web pública: clave de Resend (solo envío) y copia de seguridad opcional
RESEND_API_KEY=
# CONSULTAS_COPIA_DIR=

# false en cualquier sitio de pruebas; en producción, sin definir o true
SITE_INDEXABLE=false

# Entorno: staging hasta la publicación autorizada
PORTAL_ENTORNO=staging

# Doble factor obligatorio para el personal del despacho (true en staging y producción)
STAFF_MFA_REQUIRED=true

# Límite de subida por archivo, en MB
UPLOAD_MAX_MB=20

# ── Asistente de IA por expediente (#48) ──────────────────────────────────────────────
# Clave de la API de Anthropic. Sin ella, el asistente no aparece. Nunca en GitHub ni en registros.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-sonnet-5-5
