{
  "name": "praetoria-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seo:redirects": "node scripts/seo/generate-redirects.mjs",
    "seo:check": "node scripts/seo/inventario.mjs out",
    "seo:inventario": "node scripts/seo/inventario.mjs out --write",
    "test": "node --test 'scripts/**/*.test.mjs' 'src/**/*.test.mts'",
    "check": "npm run qa:site && npm run seo:check && node scripts/servicios/matriz.mjs --check && node scripts/imagenes/manifiesto.mjs --check && npm test",
    "imagenes": "python3 scripts/imagenes/procesar.py && node scripts/imagenes/manifiesto.mjs --write",
    "qa:site": "node scripts/qa/check-site.mjs out",
    "qa:a11y": "node scripts/qa/a11y.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ga": "rm -rf out-ga && SITE_INDEXABLE=false NEXT_PUBLIC_GA_ID=G-PRUEBA00 npm run build && mv out out-ga && SITE_INDEXABLE=false npm run build && E2E_GA=1 playwright test",
    "servicios": "node scripts/servicios/matriz.mjs",
    "check:produccion": "node scripts/servicios/matriz.mjs --produccion",
    "contenidos:importar": "node scripts/contenidos/importar.mjs",
    "medicion:informe": "node scripts/medicion/informe.mjs",
    "qa:redirecciones": "node scripts/qa/comprobar-redirecciones.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types portal/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-strip-types portal/scripts/seed.ts",
    "personal:alta": "node --env-file-if-exists=.env.local --experimental-strip-types portal/scripts/personal-alta.ts",
    "personal:invitar": "node --env-file-if-exists=.env.local --experimental-strip-types portal/scripts/personal-invitar.ts",
    "notificaciones:enviar": "node --env-file-if-exists=.env.local --experimental-strip-types portal/scripts/notificaciones.ts",
    "recordatorios": "node --env-file-if-exists=.env.local --experimental-strip-types portal/scripts/recordatorios.ts",
    "agenda:avisos": "node --env-file-if-exists=.env.local --experimental-strip-types portal/scripts/agenda.ts",
    "portal:test": "node --env-file-if-exists=.env.local --experimental-strip-types --test-concurrency=1 --test 'portal/tests/db/**/*.test.ts'",
    "portal:e2e": "playwright test -c portal/playwright.config.ts",
    "seguros:migrate": "node --env-file-if-exists=.env.local --import tsx seguros/scripts/migrate.ts",
    "seguros:demo": "node --env-file-if-exists=.env.local --import tsx seguros/scripts/demo-sintetica.ts",
    "seguros:avisos": "node --env-file-if-exists=.env.local --import tsx seguros/scripts/avisos-ejecutar.ts",
    "seguros:copia": "node --env-file-if-exists=.env.local --import tsx seguros/scripts/copia.ts",
    "seguros:copia:restaurar": "node --env-file-if-exists=.env.local --import tsx seguros/scripts/copia-restaurar.ts",
    "seguros:test": "vitest run -c seguros/vitest.config.ts"
  },
  "devDependencies": {
    "@netlify/redirect-matcher": "^0.4.2",
    "@netlify/redirect-parser": "^16.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "mailparser": "^3.12.4",
    "otpauth": "^9.5.2",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "smtp-server": "^3.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@supabase/storage-js": "^2.118.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "better-auth": "^1.7.14",
    "docx": "^9.15.2",
    "fflate": "^0.8.3",
    "file-type": "^22.2.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
