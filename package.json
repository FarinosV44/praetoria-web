{
  "name": "praetoria-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs out",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seo:redirects": "node scripts/seo/generate-redirects.mjs",
    "seo:check": "node scripts/seo/inventario.mjs out",
    "seo:inventario": "node scripts/seo/inventario.mjs out --write",
    "test": "node --test 'scripts/**/*.test.mjs' 'netlify/**/*.test.mts'",
    "check": "npm run qa:site && npm run seo:check && node scripts/servicios/matriz.mjs --check && npm test",
    "qa:site": "node scripts/qa/check-site.mjs out",
    "test:e2e": "playwright test",
    "test:e2e:ga": "rm -rf out-ga && NEXT_PUBLIC_GA_ID=G-PRUEBA00 npm run build && mv out out-ga && npm run build && E2E_GA=1 playwright test",
    "servicios": "node scripts/servicios/matriz.mjs"
  },
  "devDependencies": {
    "@netlify/redirect-matcher": "^0.4.2",
    "@netlify/redirect-parser": "^16.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "gray-matter": "^4.0.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
