---
// Una sola ruta para las áreas de práctica y los artículos, que conservan sus direcciones de siempre.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AreaPage from '../components/AreaPage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostList from '../components/PostList.astro';
import DecaBand from '../components/DecaBand.astro';
import CtaBand from '../components/CtaBand.astro';
import { areaContent, type AreaContent } from '../data/areas-content';
import { areas, categories, site } from '../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return [
    ...areaContent.map((area) => ({ params: { slug: area.slug }, props: { kind: 'area' as const, area } })),
    ...posts.map((post) => ({ params: { slug: post.id }, props: { kind: 'post' as const, post } })),
  ];
}

type Props = { kind: 'area'; area: AreaContent } | { kind: 'post'; post: CollectionEntry<'blog'> };
const props = Astro.props;

let post: CollectionEntry<'blog'> | undefined;
let Content: any;
let related: CollectionEntry<'blog'>[] = [];
if (props.kind === 'post') {
  post = props.post;
  ({ Content } = await render(post));
  related = (await getCollection('blog', (p) => p.data.category === post!.data.category && p.id !== post!.id && !p.data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);
}

const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const cat = post ? categories[post.data.category] : undefined;
const area = cat?.area ? areas.find((a) => a.slug === cat.area) : undefined;
const showUpdated =
  post?.data.updated && post.data.updated.toISOString().slice(0, 10) !== post.data.date.toISOString().slice(0, 10);

const articleLd = post && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: post.data.lang,
  mainEntityOfPage: new URL(`/${post.id}/`, site.url).href,
  author: { '@type': 'Person', name: site.lawyer, url: `${site.url}/el-despacho/` },
  publisher: { '@id': `${site.url}/#despacho` },
  keywords: post.data.tags.join(', ') || undefined,
};
---

{props.kind === 'area' && <AreaPage area={props.area} />}

{
  post && cat && (
    <Base
      title={post.data.seoTitle ?? post.data.title}
      description={post.data.description}
      type="article"
      published={post.data.date}
      modified={post.data.updated}
      schema={[articleLd!]}
    >
      <article lang={post.data.lang !== 'es' ? post.data.lang : undefined} dir={post.data.lang === 'ar' ? 'rtl' : undefined}>
        <header class="page-head">
          <div class="wrap">
            <Breadcrumbs
              items={[
                { label: 'Blog', href: '/blog/' },
                { label: cat.name, href: `/blog/categoria/${post.data.category}/` },
                { label: post.data.title },
              ]}
            />
            <h1 class="post-title">{post.data.title}</h1>
            <p class="post-meta">
              Por <a href="/el-despacho/">{site.lawyer}</a>, abogado ICAV {site.collegeNumber}. Publicado el{' '}
              <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
              {showUpdated && (
                <>
                  {' '}
                  y revisado el <time datetime={post.data.updated!.toISOString()}>{fmt.format(post.data.updated!)}</time>
                </>
              )}
              .
            </p>
          </div>
        </header>

        <div class="wrap post-grid">
          <div class="prose post-body">
            <Content />
          </div>

          <aside class="post-aside">
            {area && (
              <div class="aside-box">
                <p class="aside-box__title">¿Necesitas ayuda con un asunto así?</p>
                <p>
                  Este artículo pertenece al área de <a href={`/${area.slug}/`}>{area.name.toLowerCase()}</a>, donde
                  explicamos cómo podemos ayudarte.
                </p>
                <a class="btn btn--ghost" href={`/${area.slug}/`}>
                  Ver el área
                </a>
              </div>
            )}
            <p class="disclaimer">
              Este artículo es informativo y no sustituye el estudio de tu caso concreto. Las normas cambian: comprueba
              la fecha de revisión.
            </p>
          </aside>
        </div>
      </article>

      {post.data.category === 'transporte' && (
        <section class="section section--tight">
          <div class="wrap">
            <DecaBand campaign="articulo_blog" />
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section class="section section--stone">
          <div class="wrap">
            <h2>Más artículos de {cat.name}</h2>
            <PostList posts={related} showCategory={false} />
          </div>
        </section>
      )}

      <CtaBand />
    </Base>
  )
}

<style>
  .post-title {
    max-width: 26ch;
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3.3rem);
  }
  .post-meta {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
    max-width: 70ch;
  }
  .post-meta a {
    color: var(--ink);
  }
  .post-grid {
    display: grid;
    gap: 40px;
    padding-block: clamp(32px, 5vw, 56px) clamp(48px, 6vw, 80px);
  }
  @media (min-width: 1040px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 64px;
    }
    .post-aside {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
  .post-body > :global(:first-child) {
    margin-top: 0;
  }
  .aside-box {
    border-top: 3px solid var(--red);
    background: var(--stone);
    padding: 20px;
  }
  .aside-box__title {
    font-weight: 700;
  }
  .aside-box a:not(.btn) {
    color: var(--red-dark);
  }
  .aside-box .btn {
    padding: 0.6em 1em;
    font-size: 0.95rem;
  }
  .disclaimer {
    margin-top: 20px;
    font-size: 0.86rem;
    color: var(--muted);
  }
  [dir='rtl'] .prose blockquote {
    border-left: 0;
    border-right: 3px solid var(--red);
    padding: 0.2em 1.1em 0.2em 0;
  }
</style>
