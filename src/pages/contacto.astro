---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { site, whatsapp } from '../data/site';
---
<Base
  title="Contacto | Abogados en Valencia y El Puig"
  description="Contacta con Praetoria División Jurídica en Valencia y El Puig. Primera valoración de tu caso en transporte, mercantil, civil, familia, Hacienda o patrimonio."
>
  <section class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Contacto' }]} />
      <h1>Cuéntanos tu caso</h1>
      <p class="lede">
        Cada caso merece ser escuchado con atención. Escríbenos por el medio que prefieras y te responderemos lo antes
        posible.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <form class="form" name="contacto" method="POST" action="/gracias/" data-netlify="true" netlify-honeypot="empresa-web">
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hp"><label>No rellenes este campo <input name="empresa-web" tabindex="-1" autocomplete="off" /></label></p>

        <div class="field">
          <label for="nombre">Nombre</label>
          <input id="nombre" name="nombre" autocomplete="name" required />
        </div>
        <div class="row">
          <div class="field">
            <label for="email">Correo electrónico</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="telefono">Teléfono <span class="muted">(opcional)</span></label>
            <input id="telefono" name="telefono" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="field">
          <label for="area">¿Sobre qué es tu consulta?</label>
          <select id="area" name="area">
            <option>Transporte y logística</option>
            <option>Mercantil y sociedades</option>
            <option>Hacienda y Seguridad Social</option>
            <option>Civil, herencias y vivienda</option>
            <option>Familia y divorcio</option>
            <option>Arte y patrimonio</option>
            <option>Otro asunto</option>
          </select>
        </div>
        <div class="field">
          <label for="mensaje">¿Qué ha pasado y qué te gustaría conseguir?</label>
          <textarea id="mensaje" name="mensaje" required></textarea>
        </div>
        <fieldset class="field">
          <legend>¿Cómo prefieres que te contactemos?</legend>
          <div class="radios">
            <label><input type="radio" name="preferencia" value="Llamada" checked /> Llamada</label>
            <label><input type="radio" name="preferencia" value="Correo" /> Correo</label>
            <label><input type="radio" name="preferencia" value="WhatsApp" /> WhatsApp</label>
          </div>
        </fieldset>
        <label class="check">
          <input type="checkbox" name="privacidad" required />
          <span>He leído y acepto la <a href="/politica-de-privacidad/">política de privacidad</a>.</span>
        </label>
        <p class="small muted">
          Enviar esta consulta no crea una relación abogado-cliente ni interrumpe ningún plazo. No adjuntes documentos
          sensibles: te los pediremos por un canal seguro si hace falta.
        </p>
        <div><button class="btn btn--red" type="submit">Enviar mi consulta</button></div>
      </form>

      <aside class="direct">
        <h2>O habla directamente con nosotros</h2>
        <ul>
          <li>
            <a href={`tel:${site.phoneIntl}`}><Icon name="phone" /><span><strong>{site.phone}</strong>Teléfono</span></a>
          </li>
          <li>
            <a href={whatsapp('Hola, quiero consultar mi caso con Praetoria.')}><Icon name="whatsapp" /><span><strong>WhatsApp</strong>Al mismo número</span></a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}><Icon name="mail" /><span><strong>{site.email}</strong>Correo electrónico</span></a>
          </li>
          <li>
            <span class="noa"><Icon name="pin" /><span><strong>{site.address.street}</strong>{site.address.postalCode} {site.address.locality} ({site.address.region})</span></span>
          </li>
        </ul>
        <a class="btn btn--ghost" href="https://www.google.com/maps/dir/?api=1&destination=Calle%20Pintor%20Francisco%20Ribalta%204%2C%2046540%20El%20Puig%2C%20Valencia" rel="noopener">Cómo llegar en Google Maps</a>
      </aside>
    </div>
  </section>
</Base>
<style>
  .form { max-width: 640px; }
  .row { display: grid; gap: 1rem; }
  @media (min-width: 600px) { .row { grid-template-columns: 1fr 1fr; } }
  fieldset.field { border: 0; padding: 0; margin: 0; }
  .check a { color: var(--red-dark); }
  .direct h2 { font-size: var(--step-2); }
  .direct ul { list-style: none; padding: 0; margin: 0 0 24px; border-top: 1px solid var(--ink); }
  .direct li { border-bottom: 1px solid var(--line); }
  .direct li > a, .direct .noa { display: flex; gap: 14px; align-items: flex-start; padding: 14px 0; text-decoration: none; }
  .direct li > a:hover strong { color: var(--red); }
  .direct :global(svg) { width: 20px; height: 20px; color: var(--red); margin-top: 2px; flex: none; }
  .direct strong { display: block; }
  .direct li span { color: var(--ink-2); }
  .direct li strong { color: var(--ink); }
</style>
