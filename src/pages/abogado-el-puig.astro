---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { areas, site, whatsapp } from '../data/site';
---

<Base
  title="Abogado en El Puig"
  description="Abogado en El Puig y comarca: derecho civil, mercantil, familia, transporte, Hacienda y patrimonio. Asesoramiento cercano y respuesta rápida."
  image="/media/despacho-zona-mesas.webp"
>
  <section class="page-head">
    <div class="wrap split">
      <div>
        <Breadcrumbs items={[{ label: 'El despacho', href: '/el-despacho/' }, { label: 'Abogado en El Puig' }]} />
        <h1>Abogado en El Puig para particulares y empresas</h1>
        <p class="lede">
          En El Puig y su comarca los problemas legales no esperan: conflictos familiares, deudas, contratos, requerimientos
          de Hacienda o cuestiones patrimoniales. Ofrecemos una respuesta jurídica práctica y cercana.
        </p>
        <div class="actions">
          <a class="btn btn--red" href={whatsapp('Hola, quiero consultar mi caso con Praetoria.')}><Icon name="whatsapp" /> Consultar mi caso</a>
          <a class="btn btn--ghost" href={`tel:${site.phoneIntl}`}><Icon name="phone" /> {site.phone}</a>
        </div>
      </div>
      <img class="photo" src="/media/despacho-zona-mesas-800.webp" alt="Despacho de Praetoria en El Puig: zona de mesas" width="800" height="600" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <p>
          Conocemos la zona y a quienes viven y trabajan en ella. Por eso ofrecemos soluciones rápidas, concretas y
          orientadas a proteger tus intereses, tanto si eres particular como si diriges una empresa. Cada caso es
          distinto: empezamos siempre por escuchar tu situación antes de proponer una estrategia.
        </p>
      </div>
      <h2 class="mt">Qué asuntos atendemos en El Puig</h2>
      <ul class="index-list">
        {areas.map((a) => (
          <li>
            <h3><a href={`/${a.slug}/`}>{a.name}</a></h3>
            <p>{a.short}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--stone">
    <div class="wrap split">
      <div>
        <h2>Dónde estamos</h2>
        <address class="addr">
          <strong>{site.name}</strong><br />
          {site.address.street}<br />
          {site.address.postalCode} {site.address.locality} ({site.address.region})
        </address>
        <p>
          Atendemos en el despacho y, cuando el asunto lo permite, por teléfono o videollamada. También
          damos servicio a Puçol, Massamagrell, Rafelbunyol, La Pobla de Farnals, Museros y el resto de l'Horta Nord.
        </p>
        <div class="actions">
          <a class="btn" href="https://www.google.com/maps/dir/?api=1&destination=Calle%20Pintor%20Francisco%20Ribalta%204%2C%2046540%20El%20Puig%2C%20Valencia" rel="noopener">Cómo llegar</a>
          <a class="btn btn--ghost" href={site.googleReviews} rel="noopener">Reseñas en Google</a>
        </div>
      </div>
      <img class="photo" src="/media/despacho-atencion-cliente-800.webp" alt="Espacio de atención al cliente del despacho" width="800" height="600" loading="lazy" />
    </div>
  </section>

  <CtaBand
    title="Cuéntanos qué necesitas"
    text="Analizaremos tu situación y las opciones disponibles, ya sea un asunto personal, familiar o empresarial."
    whatsappText="Hola, necesito información sobre vuestros servicios legales en El Puig."
  />
</Base>

<style>
  .mt {
    margin-top: 1.6em;
  }
  .index-list h3 a {
    text-decoration: none;
  }
  .index-list h3 a:hover {
    color: var(--red);
  }
  .addr {
    font-style: normal;
    font-size: var(--step-1);
    line-height: 1.5;
    margin-bottom: 1em;
  }
</style>
