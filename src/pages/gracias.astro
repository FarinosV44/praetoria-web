---
import Base from '../layouts/Base.astro';
import { site, whatsapp } from '../data/site';
---
<Base title="Consulta enviada" description="Hemos recibido tu consulta." noindex>
  <section class="section">
    <div class="wrap">
      <h1>Hemos recibido tu consulta</h1>
      <p class="lede">Te responderemos lo antes posible por el medio que hayas indicado. Si tu asunto tiene un plazo que vence en los próximos días, llámanos o escríbenos por WhatsApp para que lo revisemos con prioridad.</p>
      <div class="actions">
        <a class="btn btn--red" href={whatsapp('Hola, acabo de enviar una consulta desde la web y tiene un plazo próximo.')}>Escribir por WhatsApp</a>
        <a class="btn btn--ghost" href={`tel:${site.phoneIntl}`}>Llamar al {site.phone}</a>
        <a class="btn btn--ghost" href="/">Volver al inicio</a>
      </div>
    </div>
  </section>
</Base>
