---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PostList from './PostList.astro';
import DecaBand from './DecaBand.astro';
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import type { AreaContent } from '../data/areas-content';
import { areas, categories, groups, whatsapp } from '../data/site';

interface Props {
  area: AreaContent;
}
const { area } = Astro.props;
const group = groups[area.group];
const siblings = areas.filter((a) => a.group === area.group && a.slug !== area.slug);

const all = area.category
  ? (await getCollection('blog', (p) => p.data.category === area.category && !p.data.draft)).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
    )
  : [];
const isTransport = area.category === 'transporte';
const decaGuides = all.filter((p) => p.data.deca === 'guia');
const decaTools = all.filter((p) => p.data.deca === 'herramienta');
const others = all.filter((p) => !p.data.deca);
---

<Base title={area.title} description={area.description} image={area.image.src}>
  <section class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ label: group.title, href: group.href }, { label: area.h1 }]} />
      <div class="split">
        <div>
          <h1>{area.h1}</h1>
          <p class="lede">{area.lede}</p>
          <div class="actions">
            <a class="btn btn--red" href={whatsapp(area.whatsappText)}><Icon name="whatsapp" /> Consultar por WhatsApp</a>
            <a class="btn btn--ghost" href="/contacto/">Enviar mi consulta</a>
          </div>
        </div>
        <img class="photo head-photo" src={area.image.src.replace('.webp', '-800.webp')} alt={area.image.alt} width="800" height="600" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose intro">
        {area.intro.map((p) => <p>{p}</p>)}
      </div>

      {
        area.audience && (
          <div class="audience">
            <h2>{area.audience.title}</h2>
            <ul>
              {area.audience.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        )
      }

      <h2 class="services-title">{area.servicesTitle}</h2>
      <ul class="index-list">
        {
          area.services.map((s) => (
            <li>
              <h3>{s.name}</h3>
              <div>
                {s.text && <p>{s.text}</p>}
                {s.links && (
                  <p class="more">
                    {s.links.map((l) => (
                      <a href={l.href}>{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="closing">{area.closing}</p>

      {
        area.gallery && (
          <div class="gallery">
            {area.gallery.map((g) => (
              <img class="photo" src={g.src} alt={g.alt} width="600" height="800" loading="lazy" />
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    isTransport && (
      <section class="section section--stone" id="deca">
        <div class="wrap">
          <h2>El DECA digital, explicado por un abogado del sector</h2>
          <p class="lede">
            Desde el 5 de octubre de 2026 el documento de control del transporte de mercancías por carretera debe ser
            digital. Estas guías explican quién debe hacerlo, qué riesgos asume cada parte y cómo organizarlo.
          </p>
          <div class="deca-cols">
            <div>
              <h3>Guías legales</h3>
              <PostList posts={decaGuides} showCategory={false} compact />
            </div>
            <div>
              <h3>Herramientas para generarlo</h3>
              <PostList posts={decaTools} showCategory={false} compact />
              <div class="deca-band">
                <DecaBand campaign="transporte" />
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    (isTransport ? others : all).length > 0 && (
      <section class:list={['section', { 'section--stone': !isTransport }]}>
        <div class="wrap">
          <div class="head-row">
            <h2>{isTransport ? 'Más artículos sobre transporte' : `Artículos sobre ${categories[area.category!].name.toLowerCase()}`}</h2>
            <a href={`/blog/categoria/${area.category}/`}>Ver la categoría</a>
          </div>
          <PostList posts={(isTransport ? others : all).slice(0, 6)} showCategory={false} />
        </div>
      </section>
    )
  }

  <section class="section section--tight">
    <div class="wrap">
      <p class="siblings-title">Otras áreas para {group.title.toLowerCase()}</p>
      <ul class="siblings">
        {siblings.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}
        <li><a href="/areas/">Todas las áreas</a></li>
      </ul>
    </div>
  </section>

  <CtaBand whatsappText={area.whatsappText} />
</Base>

<style>
  .head-photo {
    aspect-ratio: 4 / 3;
  }
  @media (max-width: 879px) {
    .head-photo {
      display: none;
    }
  }
  .intro {
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .audience {
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .audience h2,
  .services-title {
    font-size: var(--step-2);
  }
  .audience ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0 32px;
  }
  @media (min-width: 700px) {
    .audience ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .audience ul {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .audience li {
    padding: 12px 0 12px 18px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .audience li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15em;
    width: 8px;
    height: 2px;
    background: var(--red);
  }
  .closing {
    margin-top: 2rem;
    max-width: 62ch;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .gallery {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .gallery img {
    aspect-ratio: 3 / 4;
  }
  .deca-cols {
    display: grid;
    gap: 32px 56px;
    margin-top: 28px;
  }
  @media (min-width: 900px) {
    .deca-cols {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  .deca-cols h3 {
    margin-bottom: 10px;
  }
  .deca-band {
    margin-top: 28px;
  }
  .deca-band :global(.deca) {
    background: var(--paper);
    grid-template-columns: 1fr;
  }
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .head-row a {
    font-weight: 600;
    color: var(--red-dark);
    text-underline-offset: 3px;
  }
  .siblings-title {
    font-weight: 700;
    margin-bottom: 10px;
  }
  .siblings {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .siblings a {
    display: inline-block;
    padding: 0.55em 1em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 560;
  }
  .siblings a:hover {
    border-color: var(--ink);
  }
</style>
