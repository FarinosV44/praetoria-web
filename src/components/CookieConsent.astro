---
// Aviso de cookies. Solo aparece si hay un ID de Google Analytics configurado (PUBLIC_GA_ID).
// Analytics no se carga hasta que el visitante pulsa «Aceptar».
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{
  gaId && (
    <>
      <div class="consent" role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
        <p>
          Usamos cookies analíticas de Google Analytics para saber cuántas personas visitan la web. Solo se activan si las
          aceptas. <a href="/politica-de-cookies/">Más información</a>
        </p>
        <div class="consent__actions">
          <button type="button" class="btn btn--ghost" data-consent="denied">
            Rechazar
          </button>
          <button type="button" class="btn" data-consent="granted">
            Aceptar
          </button>
        </div>
      </div>
      <script is:inline define:vars={{ gaId }}>
        (function () {
          var KEY = 'praetoria-consent';
          var box = document.querySelector('.consent');
          function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
          function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
          function loadGA() {
            if (window.__gaLoaded) return; window.__gaLoaded = true;
            var s = document.createElement('script');
            s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { dataLayer.push(arguments); };
            gtag('js', new Date()); gtag('config', gaId, { anonymize_ip: true });
          }
          var choice = read();
          if (choice === 'granted') loadGA();
          else if (!choice && box) box.hidden = false;
          document.querySelectorAll('[data-consent]').forEach(function (b) {
            b.addEventListener('click', function () {
              var v = b.getAttribute('data-consent'); save(v); box.hidden = true;
              if (v === 'granted') loadGA();
            });
          });
          document.querySelectorAll('[data-cookie-settings]').forEach(function (b) {
            b.addEventListener('click', function () { if (box) box.hidden = false; });
          });
        })();
      </script>
    </>
  )
}

<style>
  .consent {
    position: fixed;
    z-index: 80;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 560px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 4px solid var(--red);
    padding: 18px 20px;
    box-shadow: 0 20px 50px -24px rgba(34, 38, 42, 0.55);
    font-size: 0.95rem;
  }
  .consent p {
    margin: 0 0 12px;
  }
  .consent__actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }
  .consent .btn {
    padding: 0.55em 1.1em;
    font-size: 0.95rem;
  }
  @media (max-width: 999px) {
    .consent {
      bottom: 76px;
    }
  }
</style>
