---
import { areas, groups, site, whatsapp } from '../data/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const hasAnalytics = Boolean(import.meta.env.PUBLIC_GA_ID);
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="col col--id">
      <img src="/media/logo-praetoria-sin-fondo.png" alt={site.name} width="560" height="151" loading="lazy" />
      <p>
        {site.lawyer}<br />
        Abogado colegiado n.º {site.collegeNumber} del ICAV
      </p>
      <address>
        {site.address.street}<br />
        {site.address.postalCode} {site.address.locality} ({site.address.region})
      </address>
    </div>

    <div class="col">
      <p class="col__title">{groups.empresas.title}</p>
      <ul>
        {areas.filter((a) => a.group === 'empresas').map((a) => <li><a href={`/${a.slug}/`}>{a.name}</a></li>)}
      </ul>
      <p class="col__title">{groups.particulares.title}</p>
      <ul>
        {areas.filter((a) => a.group === 'particulares').map((a) => <li><a href={`/${a.slug}/`}>{a.name}</a></li>)}
        <li><a href="/abogado-divorcio-horta-nord-valencia/">Divorcio en l'Horta Nord</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="col__title">El despacho</p>
      <ul>
        <li><a href="/el-despacho/">Quiénes somos</a></li>
        <li><a href="/abogado-el-puig/">Abogado en El Puig</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href={site.googleReviews} rel="noopener">Reseñas en Google</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="col__title">Contacto</p>
      <ul class="contact">
        <li><a href={`tel:${site.phoneIntl}`}><Icon name="phone" /> {site.phone}</a></li>
        <li><a href={whatsapp()}><Icon name="whatsapp" /> WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
        <li><a href={site.linkedin} rel="noopener"><Icon name="linkedin" /> LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <p>© {year} {site.legalName}. {site.name}.</p>
    <ul>
      <li><a href="/aviso-legal/">Aviso legal</a></li>
      <li><a href="/politica-de-privacidad/">Privacidad</a></li>
      <li><a href="/politica-de-cookies/">Cookies</a></li>
      {hasAnalytics && <li><button type="button" class="linklike" data-cookie-settings>Configurar cookies</button></li>}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--stone);
    border-top: 3px solid var(--red);
    padding-top: clamp(40px, 6vw, 72px);
    font-size: 0.95rem;
  }
  .cols {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .cols {
      grid-template-columns: 1.3fr 1.2fr 0.9fr 1.1fr;
    }
  }
  .col--id img {
    width: 170px;
    margin-bottom: 16px;
  }
  address {
    font-style: normal;
    color: var(--ink-2);
  }
  .col__title {
    font-weight: 700;
    margin: 0 0 8px;
  }
  .col__title:not(:first-child) {
    margin-top: 20px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin-bottom: 6px;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .contact :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--red);
  }
  .legal {
    margin-top: 40px;
    padding-block: 18px 22px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .legal p {
    margin: 0;
  }
  .legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .legal li {
    margin: 0;
  }
  .linklike {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .linklike:hover {
    text-decoration: underline;
  }
</style>
