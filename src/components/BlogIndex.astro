---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PostList from './PostList.astro';
import CtaBand from './CtaBand.astro';
import { areas, categories, type CategoryKey } from '../data/site';

interface Props { category?: CategoryKey }
const { category } = Astro.props;
const all = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const counts = Object.fromEntries(Object.keys(categories).map((k) => [k, all.filter((p) => p.data.category === k).length]));
const posts = category ? all.filter((p) => p.data.category === category) : all;
const cat = category ? categories[category] : undefined;
const area = cat?.area ? areas.find((a) => a.slug === cat.area) : undefined;
const title = cat ? `${cat.name}: artículos` : 'Blog jurídico';
const description = cat
  ? `Artículos de ${cat.name.toLowerCase()} escritos por Juan José Farinós Ibáñez, abogado en El Puig y Valencia.`
  : 'Guías y artículos prácticos sobre transporte y DECA, Hacienda, mercantil, vivienda, familia, laboral y extranjería.';
---
<Base title={title} description={description}>
  <section class="page-head">
    <div class="wrap">
      <Breadcrumbs items={cat ? [{ label: 'Blog', href: '/blog/' }, { label: cat.name }] : [{ label: 'Blog' }]} />
      <h1>{cat ? cat.name : 'Blog jurídico'}</h1>
      <p class="lede">
        {cat
          ? area
            ? <>Artículos prácticos sobre {cat.name.toLowerCase()}. Si necesitas ayuda con un caso, consulta el área de <a href={`/${area.slug}/`}>{area.name.toLowerCase()}</a>.</>
            : <>Artículos prácticos sobre {cat.name.toLowerCase()}.</>
          : 'Explicaciones claras sobre los problemas jurídicos que más nos consultan, ordenadas por tema.'}
      </p>
      <nav class="cats" aria-label="Categorías del blog">
        <a href="/blog/" aria-current={!category ? 'page' : undefined}>Todos <span>{all.length}</span></a>
        {(Object.keys(categories) as CategoryKey[]).filter((k) => counts[k] > 0).map((k) => (
          <a href={`/blog/categoria/${k}/`} aria-current={category === k ? 'page' : undefined}>
            {categories[k].name} <span>{counts[k]}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <PostList posts={posts} showCategory={!category} />
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .lede a { color: var(--red-dark); }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .cats a {
    text-decoration: none; padding: 0.45em 0.85em; border: 1px solid var(--line); border-radius: var(--radius);
    font-size: 0.93rem; font-weight: 560; background: var(--paper);
  }
  .cats a span { color: var(--muted); font-weight: 400; margin-left: 4px; }
  .cats a:hover { border-color: var(--ink); }
  .cats a[aria-current] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .cats a[aria-current] span { color: #c4c8cc; }
</style>
